{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-digest-feedback",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // KV с оценками и отметками читателя. id закреплён: без него деплой полагается на автопривязку, и пустое
  // новое хранилище молча потеряло бы все голоса. id — не секрет, без учётных данных Cloudflare он бесполезен
  "kv_namespaces": [{ "binding": "VOTES", "id": "80fa5aa4ea8348e3b20708a08b931ef9" }],
  "vars": {
    // Только с этого сайта страница может присылать оценки (CORS + проверка Origin)
    "PAGE_ORIGIN": "https://riobvo.github.io",
    // Репозиторий, в котором планировщик запускает сборки
    "GITHUB_REPO": "RiobVO/ai-digest"
  },
  // Время держит Cloudflare, а не GitHub: 08:07 и 18:07 по Ташкенту — выпуски, :17 каждого часа — срочные
  "triggers": { "crons": ["7 3 * * *", "7 13 * * *", "17 * * * *"] },
  "observability": { "enabled": true }
  // Секреты: TELEGRAM_BOT_TOKEN, WEBHOOK_SECRET, READ_TOKEN, OWNER_CHAT_ID, SCHEDULER_TOKEN — через `wrangler secret put`
}
